generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  password            String               @default("password123")
  role                Role                 @default(AGENT)
  isLocked            Boolean              @default(false)
  lockedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  avatarUrl           String?
  bio                 String?
  email               String?
  fullName            String?              @default("")
  phoneNumber         String?
  callLogs            CallLog[]
  customers           Customer[]
  customerAssignments CustomerAssignment[]

  @@index([role])
  @@map("user")
}

model Customer {
  id                String               @id @default(cuid())
  customerCode      String               @unique
  fullName          String
  name              String?
  phone             String
  area              String?
  address           String?
  taxCode           String?
  groupCode         String?
  partner           String?
  status            String               @default("Mới")
  callbackTime      String?
  totalRevenue      Float                @default(0)
  assignedTo        String
  assignedToId      String?
  medicalRep        String               @default("Admin")
  email             String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  birthday          DateTime?
  lastOrderAt       DateTime?
  productsPurchased String?
  zaloConnected     Boolean              @default(false)
  contractSignedAt  DateTime?
  bankAccount       String?
  district          String?
  callLogs          CallLog[]
  assignedToUser    User?                @relation(fields: [assignedToId], references: [id])
  assignments       CustomerAssignment[]

  @@index([fullName])
  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@index([district])
  @@map("cust")
}

model CustomerAssignment {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId])
  @@index([userId])
  @@index([customerId])
  @@map("customer_assignment")
}

model CallLog {
  id                String     @id @default(cuid())
  customerId        String
  agentId           String?
  agentName         String
  customerName      String
  callStatus        CallStatus @default(MOI)
  revenue           Float      @default(0)
  callbackDate      DateTime?
  callbackTime      String?
  note              String?
  notes             String?
  timestamp         DateTime   @default(now())
  callAt            DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  productsPurchased String?
  productIds        String[]
  agent             User?      @relation(fields: [agentId], references: [id])
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([agentId])
  @@index([callStatus])
  @@index([callbackDate])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@index([name])
  @@map("product_category")
}

model Product {
  id         String          @id @default(cuid())
  name       String
  code       String?
  isActive   Boolean         @default(true)
  categoryId String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  price      Int             @default(0)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([categoryId])
  @@map("product")
}

enum CallStatus {
  CHOT_DON
  TU_CHOI
  MOI
  UPSALE
  HEN_GOI_LAI
}

enum Role {
  ADMIN
  AGENT
}
